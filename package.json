{
  "name": "choucroute-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "choucroute — the earbox home listening device (Python firmware + hardware) plus a Turbo/bun JS monorepo for the transcript-monitoring web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tony8713/choucroute.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "choucroute typecheck",
    "lint": "choucroute lint",
    "lint:fix": "choucroute lint --fix",
    "madge": "choucroute madge",
    "check": "bun run lint && choucroute typecheck"
  },
  "devDependencies": {
    "@choucroute/config": "workspace:*",
    "eslint": "^10.3.0",
    "madge": "^8.0.0",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  }
}
