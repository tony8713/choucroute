{
  "name": "@choucroute/config",
  "version": "0.1.0",
  "description": "Shared ESLint, TypeScript and madge config presets for the choucroute monorepo (mirrors bonustrack/stage @stage-labs/config).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tony8713/choucroute.git",
    "directory": "packages/config"
  },
  "type": "module",
  "private": true,
  "files": [
    "bin",
    "eslint",
    "madge",
    "tsconfig",
    "define.js",
    "lint.js",
    "README.md"
  ],
