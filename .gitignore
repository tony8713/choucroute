# NEVER commit audio. This is a privacy invariant, not a preference.
*.wav
*.aiff
*.aif
*.raw
*.pcm
*.flac
*.mp3
*.m4a
*.ogg
*.opus

# dev scratch (test audio, throwaway harness memory)
scratch/

# python
__pycache__/
*.pyc

# on-device earbox-owned venv (lives inside the clone) + generated LAN TLS certs
/venv/
/tls/

# hardware CAD toolchain clone + venv (not source)
tools/

# generated CAD scratch
*.step.glb
.*.step.glb
