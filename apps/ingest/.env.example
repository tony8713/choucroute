# earbox audio-ingest — env config. All optional; defaults are production-safe.

PORT=8080
INGEST_PATH=/ingest
ACK_INTERVAL_MS=2000
ROLLING_BUFFER_SECONDS=30

# Auth is DEFERRED, NOT REMOVED (Less "no auth for now", 2026-07-23; Iris security review).
# The bearer/?token= check ships PRESENT in the code but is gated off by default,
# so re-enabling is a one-line flag flip + a secret — no rebuild:
#   fly secrets set STREAM_TOKEN=<random>   # then set AUTH_ENABLED=1
# A public unauthenticated live-audio endpoint is a known hole for this
# confidentiality-critical product; turn this on before any non-test use.
AUTH_ENABLED=0
STREAM_TOKEN=

# Persist audio to disk = OFF by default (privacy invariant). Leave empty.
# Only an in-memory rolling buffer (ROLLING_BUFFER_SECONDS) is kept.
PERSIST_DIR=
